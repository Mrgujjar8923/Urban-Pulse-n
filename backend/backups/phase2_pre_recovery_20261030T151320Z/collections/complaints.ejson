n times to affected residents.","analyzedAt":{"$date":{"$numberLong":"1793167078567"}}},"timeline":[{"status":"Pending","timestamp":{"$date":{"$numberLong":"1793167078567"}},"_id":{"$oid":"6ae18ee6898e3ef7f755594d"}},{"status":"Assigned","timestamp":{"$date":{"$numberLong":"1793171067439"}},"_id":{"$oid":"6ae19e7b57d7edfce1ad7ee9"}},{"status":"Pending","timestamp":{"$date":{"$numberLong":"1793171081837"}},"_id":{"$oid":"6ae19e8957d7edfce1ad7efe"}},{"status":"In Progress","timestamp":{"$date":{"$numberLong":"1793171087477"}},"_id":{"$oid":"6ae19e8f57d7edfce1ad7f0b"}},{"status":"Resolved","timestamp":{"$date":{"$numberLong":"1793171093436"}},"_id":{"$oid":"6ae19e9557d7edfce1ad7f1a"}}],"createdAt":{"$date":{"$numberLong":"1793167078581"}},"updatedAt":{"$date":{"$numberLong":"1793171093437"}},"__v":{"$numberInt":"4"}},{"_id":{"$oid":"6ae1a2d66102f452ba514a11"},"title":"Water supply interruption reported 28 oct 2","description":"bhaut dino se pani nahi aa rha hai","category":"Water Supply","status":"Resolved","location":"Junction 27, Sector 22, Chandigarh, 160018, India","latitude":{"$numberDouble":"30.7333148"},"longitude":{"$numberDouble":"76.7794179"},"image":"uploaded","assignedTo":{"$oid":"69e08222f55981d3faedf6d8"},"createdBy":{"$oid":"6aaffdb60d4d4252133081a6"},"feedback":null,"aiAnalysis":{"detectedLanguage":"Hinglish","englishTranslation":"Water has not been coming for many days.","category":"Water Supply","priority":"Critical","urgencyScore":{"$numberInt":"9"},"confidence":{"$numberDouble":"0.95"},"reasoning":"The complaint explicitly states 'Water supply interruption' in the title and 'pani nahi aa rha hai' (water is not coming) in the description, clearly indicating a water supply issue. The phrase 'bhaut dino se' (for many days) suggests a prolonged problem, elevating the priority to Critical due to the essential nature of water.","detectedIssue":"Prolonged water supply interruption","affectedArea":"Unspecified","recommendedDepartment":"Water Supply","recomm