# ==============================================================================
# GovAI Resolve Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# NOTE: Never commit .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Runtime environment ("development" | "production" | "test")
NODE_ENV=production

# [OPTIONAL] Port on which the Express HTTP and Socket.IO server listens (default: 5000)
PORT=5000

# [OPTIONAL] Reverse proxy trust hop count or CIDR (default: 1 for Nginx / AWS ALB / Cloudflare)
# Set to 1 if behind a single reverse proxy or ingress controller.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# [REQUIRED] MongoDB connection string (e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# [OPTIONAL] Database name inside the cluster (default: govai)
MONGO_DB_NAME=govai

# [OPTIONAL] Mongoose automatic index creation on startup (default: false)
# WARNING: Keep false in production to prevent startup connection locks.
# Build indexes using the dedicated migration script instead.
AUTO_INDEX=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [REQUIRED] Cryptographic secret key used to sign and verify JSON Web Tokens (JWT).
# Generate using: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_256_bit_random_secret

# [REQUIRED IN PRODUCTION] Comma-separated list of allowed frontend origins for CORS.
# You may also supply CLIENT_URL or FRONTEND_URL (e.g., on Render).
# Requests from origins not listed here will be blocked by CORS middleware.
FRONTEND_ORIGINS=https://resolve.govai.gov,http://localhost:8080
CLIENT_URL=https://your-frontend.onrender.com

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED] Google Gemini API Key for civic complaint categorization and citizen assistant chat.
# Obtain from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. EVIDENCE & FILE STORAGE
# ------------------------------------------------------------------------------
# [OPTIONAL] Absolute or relative directory path for storing complaint evidence images.
# In production, this must point to a persistent disk mount or volume.
# Default: ./uploads (relative to backend working directory)
EVIDENCE_UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 6. BACKGROUND SLA & ESCALATION ENGINE
# ------------------------------------------------------------------------------
# [OPTIONAL] Whether to run the background SLA escalation scheduler inside this process (default: true)
# Set to false if running the SLA escalation job in a dedicated worker process.
ENABLE_SLA_JOB=true

# [OPTIONAL] Polling interval in milliseconds for SLA breach checks (default: 60000 = 1 minute)
SLA_ESCALATION_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 7. RATE LIMITING THRESHOLDS
# ------------------------------------------------------------------------------
# [OPTIONAL] Global API max requests per 15-minute window per IP (default: 500)
RATE_LIMIT_GLOBAL_MAX=500

# [OPTIONAL] Auth endpoint (login/register) max requests per 15-minute window per IP (default: 20)
RATE_LIMIT_AUTH_MAX=20

# [OPTIONAL] Assistant / Chatbot max requests per 1-minute window per user/IP (default: 30)
RATE_LIMIT_ASSISTANT_MAX=30

# [OPTIONAL] Complaint creation max submissions per 15-minute window per user/IP (default: 30)
RATE_LIMIT_COMPLAINT_MAX=30
